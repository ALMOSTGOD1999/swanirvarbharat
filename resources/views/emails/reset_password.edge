@layout.email({ title: 'Forget your Swanirvarbharat password?' })

  @emails.paragraph()
    Hi {{ user.username }},
  @end

  @emails.paragraph()
    Please use the link below to reset your password.
    This link will be valid for the next hour, after which, you'll need to request a new one at
    <a style="color: #9b9b9b;" href="https://swanirvarbharat.com/forgot-password">https://swanirvarbharat.com/forgot-password</a>
  @end

  @emails.button({ href })
    Reset Your Password
  @end

  @!emails.signature()

  @emails.paragraph()
    <a href="{{ href }}">{{ href }}</a>
  @end

@end
